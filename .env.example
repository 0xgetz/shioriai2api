# shioriai2api configuration
# Copy to .env and fill in. Never commit .env.

# Local HTTP port
PORT=8080

# Required: the key your clients use to call the proxy
PROXY_API_KEY=change-me

# Long-lived shiori.ai credential (get it from the browser, see README)
SHIORI_REFRESH_TOKEN=

# Optional: file with one refresh token per line for multi-account rotation
# SHIORI_ACCOUNTS_FILE=accounts.txt

# Optional: needed only when the proxy runs on a different IP than the browser
# SHIORI_COOKIE=
# SHIORI_PROXY=http://user:pass@host:port

# Optional overrides
# SHIORI_BASE_URL=https://www.shiori.ai
# DEFAULT_MODEL=glm-5.3-flash
# CONVERSATION_TTL=30m
# MAX_CONVERSATIONS=1024
